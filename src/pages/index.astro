---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import SupportPanel from '../components/SupportPanel.astro';
import EmptyState from '../components/EmptyState.astro';
import StatsBoard from '../components/StatsBoard.astro';
import { catalog, channelDirectory, getFeatured, videoPath } from '../lib/catalog';
import { formatDate, formatDateTime, formatNumber } from '../lib/format';
import { connectedSocials, channelSocials, standardSocials } from '../config/social';
import ChannelBadges from '../components/ChannelBadges.astro';
import { site } from '../config/site';

const featured = getFeatured();
const liveVideo = catalog.live ? catalog.videos.find((video) => video.id === catalog.live?.videoId) ?? null : null;
const hero = liveVideo ?? featured;
const channels = channelDirectory();
const reagiert = channels.find((channel) => channel.id === 'reagiert');
const reactionVideos = reagiert
  ? catalog.videos.filter((video) => video.channelId === reagiert.channelId).slice(0, 4)
  : [];
const latest = catalog.videos.slice(0, 8);
const origin = site.url;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    legalName: site.publisher.legalName,
    url: origin,
    email: site.contactEmail,
    logo: new URL('/brand/mark.jpg', origin).href,
    sameAs: connectedSocials.map((item) => item.profileUrl || item.href),
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.publisher.street,
      postalCode: site.publisher.postalCode,
      addressLocality: site.publisher.city,
      addressCountry: site.publisher.countryCode,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: origin,
    inLanguage: 'de-DE',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${origin}/suche/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
];
---
<Base title={site.name} description={site.description} image={hero?.thumbnail || '/brand/mark.jpg'} jsonLd={jsonLd}>
  {catalog.live && (
    <aside class="live-banner">
      <div class="wrap">
        <p><span class="live-dot" aria-hidden="true"></span><strong>{catalog.live.channelName}</strong> ist jetzt live</p>
        <a class="link-arrow" href={liveVideo ? videoPath(liveVideo) : catalog.live.url} rel={liveVideo ? undefined : 'noopener noreferrer'}>Livestream ansehen</a>
      </div>
    </aside>
  )}

  <div class="wrap">
    <section class="hero-brand">
      <p class="kicker">Digitale Medienplattform</p>
      <h1>Politik mit Kopf</h1>
      <p class="lede">{site.description}</p>
      <div class="hero-actions">
        <a class="button" href="/videos/">Neueste Videos ansehen</a>
        <a class="button ghost" href="/unsere-kanaele/">Meine Kanäle entdecken</a>
      </div>
      {catalog.syncedAt && (
        <p class="sync-note">
          Stand der Videos:
          <time data-sync-stamp datetime={catalog.syncedAt}>{formatDateTime(catalog.syncedAt)}</time>
        </p>
      )}
    </section>

    {hero ? (
      <div class="hero-split">
        <a class="hero-feature" href={videoPath(hero)}>
          <div class="thumb">
            <img src={hero.thumbnail} alt="" width="1280" height="720" fetchpriority="high" decoding="async" data-fallback={hero.thumbnailRemote} />
            <span class="play" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9 7.2v9.6L17.5 12 9 7.2z"/></svg>
            </span>
          </div>
          <p class="kicker">{catalog.live && liveVideo ? 'Live' : 'Im Fokus'}</p>
          <p class="byline"><span>{hero.channelName}</span><time datetime={hero.publishedAt}>{formatDate(hero.publishedAt)}</time></p>
          <h2>{hero.title}</h2>
          <p class="excerpt">{hero.excerpt}</p>
        </a>
        <aside class="surface" style="padding:20px;display:grid;gap:14px;align-content:start">
          <p class="kicker">Zwei Kanäle — eine Plattform</p>
          {channels.map((channel) => (
            <article>
              <h3 style="margin:0 0 6px;font-size:1.15rem">{channel.name}</h3>
              <p class="sync-note" style="margin:0 0 8px">{channel.description}</p>
              {channel.stats?.subscriberCount != null && (
                <p style="margin:0 0 8px"><strong>{formatNumber(channel.stats.subscriberCount)}</strong> Abonnenten</p>
              )}
              <a class="link-arrow" href={`/${channel.slug || 'politik-mit-kopf'}/`}>Kanal öffnen</a>
            </article>
          ))}
        </aside>
      </div>
    ) : (
      <EmptyState title="Aktuell sind noch keine Videos übernommen." actionHref="/" action="Erneut versuchen" />
    )}
  </div>

  <StatsBoard />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Neueste Videos</h2>
        <a class="link-arrow" href="/videos/">Ins Archiv</a>
      </div>
      <div class="mosaic">
        {latest.map((video, index) => <VideoCard video={video} variant={index === 0 ? 'lead' : 'standard'} priority={index === 0} />)}
      </div>
    </div>
  </section>

  {reagiert && reactionVideos.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">Reaktionskanal</p>
            <h2>Politik mit Kopf REAGIERT</h2>
          </div>
          <a class="link-arrow" href="/politik-mit-kopf-reagiert/">Zum Kanal</a>
        </div>
        <div class="rail">
          {reactionVideos.map((video) => <VideoCard video={video} variant="rail" />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="informant-banner">
        <p class="kicker">Vertraulich</p>
        <h2>Informant werden</h2>
        <p>Sie verfügen über relevante Informationen, Hinweise oder Unterlagen? Erfahren Sie, wie Sie mit Politik mit Kopf vertraulich Kontakt aufnehmen können.</p>
        <a class="button" href="/informant-werden/">Hinweise übermitteln</a>
      </div>
    </div>
  </section>

  <section class="band section">
    <div class="wrap">
      <div class="section-head" style="border-color:var(--band-line)">
        <h2>Politik mit Kopf folgen</h2>
      </div>
      <ChannelBadges size="section" />
      <div class="social-list">
        {channelSocials.map((item) => (
          <a class="row" href={item.href} rel="noopener noreferrer">
            <h3>{item.label}</h3>
            <p>{item.description}</p>
            <span class="link-arrow">Kanal öffnen</span>
          </a>
        ))}
        {standardSocials.map((item) => (
          <a class="row" href={item.href} rel="noopener noreferrer">
            <h3>{item.label}</h3>
            <p>{item.description}</p>
            <span class="link-arrow">{item.label} öffnen</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <p class="kicker">Unterstützung</p>
        <h2>Projekt unterstützen</h2>
        <p>Sie möchten die Arbeit von Politik mit Kopf unterstützen? Hier finden Sie die verfügbaren Möglichkeiten.</p>
        <p><a class="link-arrow" href="/unterstuetzen/">Alle Angaben</a></p>
      </div>
      <SupportPanel compact={true} />
    </div>
  </section>
</Base>
