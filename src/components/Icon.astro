---
interface Props {
  name: 'play' | 'search' | 'menu' | 'close' | 'sun' | 'moon' | 'arrow' | 'youtube' | 'tiktok';
  size?: number;
}
const { name, size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'play' && <path d="M9 7.2v9.6L17.5 12 9 7.2z" fill="currentColor" stroke="none" />}
  {name === 'search' && <><circle cx="11" cy="11" r="6" /><path d="M16 16l4 4" /></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'sun' && <><circle cx="12" cy="12" r="3.5" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" /></>}
  {name === 'moon' && <path d="M15 4.5A7.5 7.5 0 1 0 19.5 15 6 6 0 0 1 15 4.5z" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'youtube' && (
    <path
      fill="currentColor"
      stroke="none"
      d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8zM9.75 15.5v-7L16 12l-6.25 3.5z"
    />
  )}
  {name === 'tiktok' && (
    <path
      fill="currentColor"
      stroke="none"
      d="M19.6 7.8a5.6 5.6 0 0 1-3.3-1.1v7.1a5.7 5.7 0 1 1-5.7-5.7c.3 0 .6 0 .9.1v2.9a2.8 2.8 0 1 0 2 2.7V2.5h2.8a5.6 5.6 0 0 0 3.3 3.2v2.1z"
    />
  )}
</svg>
