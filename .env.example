# Optional. Ohne Schlüssel liest die Synchronisation den öffentlichen RSS-Feed
# (die letzten 15 Videos je Kanal). Mit Schlüssel wird das Archiv über die
# YouTube Data API erweitert, inklusive Laufzeit und Live-Status.
YOUTUBE_API_KEY=

# Optional. Überschreibt die Kanal-ID des als featured markierten Kanals
# in src/config/youtube.json. Weitere Kanäle werden in dieser Datei gepflegt.
YOUTUBE_CHANNEL_ID=

# Optional. Öffentliche HTTPS-Adresse, die das Kontaktformular per POST JSON
# annimmt. Ohne Adresse wird nichts versendet.
PUBLIC_CONTACT_ENDPOINT=
