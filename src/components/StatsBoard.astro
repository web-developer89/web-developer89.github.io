---
import { channelDirectory, catalog, getTikTok } from '../lib/catalog';
import { formatDateTime, formatNumber } from '../lib/format';
import snapshotsFile from '../data/snapshots.json';

const channels = channelDirectory();
const tiktokChannel = getTikTok();
const payload = {
  syncedAt: catalog.syncedAt,
  channels: channels.map((channel) => ({
    id: channel.id,
    channelId: channel.channelId,
    name: channel.name,
    stats: channel.stats,
  })),
  videos: catalog.videos.map((video) => ({
    id: video.id,
    channelId: video.channelId,
    stats: video.stats,
  })),
  snapshots: snapshotsFile,
};
const json = JSON.stringify(payload).replace(/</g, '\\u003c');
---
<section class="section" id="zahlen" data-stats-refresh>
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Unsere Kanäle in Zahlen</h2>
        <p class="lede">Aktuelle Zahlen und Entwicklungen unserer Kanäle.</p>
      </div>
    </div>
    {tiktokChannel && (
      <aside class="tiktok-stats" aria-label="TikTok-Statistiken">
        <div class="tiktok-stats-copy">
          <p class="kicker">TikTok</p>
          <h3>{tiktokChannel.handle}</h3>
          <p>{tiktokChannel.description}</p>
        </div>
        <dl class="tiktok-stats-metrics">
          <div>
            <dt>Follower</dt>
            <dd>{formatNumber(tiktokChannel.stats.followerCount)}</dd>
          </div>
          <div>
            <dt>Likes</dt>
            <dd>{formatNumber(tiktokChannel.stats.likeCount)}</dd>
          </div>
          <div>
            <dt>Videos</dt>
            <dd>{formatNumber(tiktokChannel.stats.videoCount)}</dd>
          </div>
        </dl>
        <a class="button ghost" href={tiktokChannel.profileUrl} rel="noopener noreferrer">TikTok öffnen</a>
      </aside>
    )}
    <div class="stats-board" data-stats-board>
      <div class="stats-controls">
        <div class="chip-row" role="group" aria-label="Kanalauswahl" data-channel-filters>
          <button class="chip" type="button" data-channel="all">Beide Kanäle</button>
          {channels.map((item) => (
            <button class:list={['chip', { 'is-active': item.id === 'primary' }]} type="button" data-channel={item.id}>{item.name}</button>
          ))}
        </div>
        <div class="chip-row" role="group" aria-label="Zeitraum" data-period-filters>
          <button class="chip" type="button" data-period="24h">24 Stunden</button>
          <button class="chip is-active" type="button" data-period="7d">7 Tage</button>
          <button class="chip" type="button" data-period="30d">30 Tage</button>
        </div>
      </div>

      <div class="metric-grid" data-metric-grid></div>

      <div class="chart-panel" data-growth-panel>
        <div class="growth-strip">
          <div class="growth-copy">
            <div class="growth-meta">
              <h3>Kanalentwicklung</h3>
              <div class="chip-row" role="group" aria-label="Kennzahl der Entwicklung">
                <button class="chip chip-mini is-active" type="button" data-growth-metric="views">Aufrufe</button>
                <button class="chip chip-mini" type="button" data-growth-metric="subscribers">Abonnenten</button>
              </div>
            </div>
            <p class="growth-delta" data-growth-delta>—</p>
            <p class="growth-note">
              Stand:
              <time data-sync-stamp datetime={catalog.syncedAt || ''}>
                {catalog.syncedAt ? formatDateTime(catalog.syncedAt) : 'noch keine Synchronisierung'}
              </time>
            </p>
            <p class="growth-note" data-growth-caption></p>
          </div>
          <div class="growth-chart" data-chart-root aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" id="stats-payload" set:html={json} />
</section>
<script>
  import { setupStatsBoard } from '../scripts/stats-board.ts';
  setupStatsBoard();
</script>
