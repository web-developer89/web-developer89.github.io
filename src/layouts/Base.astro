---
import '@fontsource-variable/jost/wght.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/global.css';
import '../styles/premium.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { searchIndex } from '../lib/search';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: unknown;
}

const { title, description = site.description, image = '/brand/mark.jpg', ogType = 'website', noindex = false, jsonLd } = Astro.props;
const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const isNotFound = Astro.url.pathname === '/404/';
const canonical = new URL(Astro.url.pathname, site.url);
const imageUrl = image.startsWith('http') ? image : new URL(image, site.url).href;
const indexJson = JSON.stringify(searchIndex()).replace(/</g, '\\u003c');
const schema = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---
<!doctype html>
<html lang="de-DE" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!isNotFound && <link rel="canonical" href={canonical.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/mark.jpg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={fullTitle} />
    {noindex && <meta name="robots" content="noindex" />}
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <dialog class="search-dialog" data-search-dialog aria-label="Suche">
      <div class="search-sheet">
        <div class="search-top">
          <p class="kicker" data-search-label>Zuletzt veröffentlicht</p>
          <form method="dialog"><button class="tool" type="submit">Schließen</button></form>
        </div>
        <form action="/suche/" method="get" role="search">
          <label class="field">
            <span>Was möchten Sie finden?</span>
            <input name="q" type="search" data-search-input autocomplete="off" enterkeyhint="search" />
          </label>
        </form>
        <div class="search-results" data-search-results aria-live="polite"></div>
      </div>
    </dialog>
    <script type="application/json" id="search-index" set:html={indexJson} />
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
