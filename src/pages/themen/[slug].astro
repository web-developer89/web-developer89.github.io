---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VideoCard from '../../components/VideoCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { topics, topicStatement } from '../../config/topics';
import { videosForTopic } from '../../lib/catalog';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

interface Props {
  topic: (typeof topics)[number];
}
const { topic } = Astro.props;
const videos = videosForTopic(topic.slug);
---
<Base title={topic.title} description={`${topic.title}. ${topicStatement}`}>
  <div class="wrap">
    <Breadcrumbs items={[{ href: '/themen/', label: 'Themen' }, { href: `/themen/${topic.slug}/`, label: topic.title }]} />
    <PageHeader
      kicker="Thema"
      title={topic.title}
      lede="Dieser Schwerpunkt ist in der Beschreibung von Politik mit Kopf genannt. Hier erscheinen Videos, deren Beschreibung das passende Schlagwort enthält."
    />
    {videos.length === 0 ? (
      <EmptyState title="Aktuell sind in diesem Bereich noch keine Beiträge vorhanden." actionHref="/videos/" action="Alle Videos ansehen" />
    ) : (
      <div class="cards">
        {videos.map((video) => <VideoCard video={video} />)}
      </div>
    )}
  </div>
</Base>
