---
import { channelDirectory, catalog, getTikTok } from '../lib/catalog';
import { formatDateTime } from '../lib/format';

const channels = channelDirectory();
const tiktokChannel = getTikTok();
const payload = {
  syncedAt: catalog.syncedAt,
  channels: [
    ...channels.map((channel) => ({
      id: channel.id,
      channelId: channel.channelId,
      name: channel.name,
      platform: 'youtube',
      stats: channel.stats,
    })),
    ...(tiktokChannel
      ? [{
          id: 'tiktok',
          channelId: 'tiktok',
          name: 'TikTok',
          platform: 'tiktok',
          stats: {
            subscriberCount: tiktokChannel.stats.followerCount,
            viewCount: null,
            videoCount: tiktokChannel.stats.videoCount,
            likeCount: tiktokChannel.stats.likeCount,
            hiddenSubscriberCount: false,
          },
        }]
      : []),
  ],
  videos: catalog.videos.map((video) => ({
    id: video.id,
    channelId: video.channelId,
    stats: video.stats,
  })),
  tiktok: tiktokChannel,
  snapshots: {
    channelSnapshots: [] as Array<{ at: string; channelId: string; subscriberCount: number | null; viewCount: number | null }>,
    videoSnapshots: [] as Array<{ at: string; videoId: string; channelId: string; viewCount: number | null; likeCount: number | null; commentCount: number | null }>,
  },
};
const json = JSON.stringify(payload).replace(/</g, '\\u003c');
---
<section class="section" id="zahlen" data-stats-refresh>
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Meine Kanäle in Zahlen</h2>
        <p class="lede">YouTube und TikTok – aktuelle Zahlen und Entwicklungen.</p>
      </div>
    </div>
    <div class="stats-board" data-stats-board>
      <div class="stats-controls">
        <div class="chip-row" role="group" aria-label="Kanalauswahl" data-channel-filters>
          <button class="chip" type="button" data-channel="all">Alle Kanäle</button>
          {channels.map((item) => (
            <button class:list={['chip', { 'is-active': item.id === 'primary' }]} type="button" data-channel={item.id}>{item.name}</button>
          ))}
          {tiktokChannel && (
            <button class="chip" type="button" data-channel="tiktok">TikTok</button>
          )}
        </div>
        <div class="chip-row" role="group" aria-label="Zeitraum" data-period-filters>
          <button class="chip" type="button" data-period="24h">24 Stunden</button>
          <button class="chip" type="button" data-period="7d">7 Tage</button>
          <button class="chip is-active" type="button" data-period="30d">30 Tage</button>
        </div>
      </div>

      <div class="metric-grid" data-metric-grid></div>

      <div class="chart-panel" data-growth-panel>
        <div class="growth-strip">
          <div class="growth-copy">
            <div class="growth-meta">
              <h3>Kanalentwicklung</h3>
              <div class="chip-row" role="group" aria-label="Kennzahl der Entwicklung" data-growth-metric-filters>
                <button class="chip chip-mini is-active" type="button" data-growth-metric="views">Aufrufe</button>
                <button class="chip chip-mini" type="button" data-growth-metric="subscribers">Abonnenten</button>
              </div>
            </div>
            <p class="growth-delta" data-growth-delta>—</p>
            <p class="growth-note">
              Stand:
              <time data-sync-stamp datetime={catalog.syncedAt || ''}>
                {catalog.syncedAt ? formatDateTime(catalog.syncedAt) : 'noch keine Synchronisierung'}
              </time>
              <span data-refresh-note> · Aktualisierung jede Minute</span>
            </p>
            <p class="growth-note" data-growth-caption></p>
          </div>
          <div class="growth-chart" data-chart-root aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" id="stats-payload" set:html={json} />
</section>
<script>
  const section = document.querySelector('[data-stats-refresh]');
  const boot = () => {
    import('../scripts/stats-board.ts').then((mod) => mod.setupStatsBoard());
  };
  if (section instanceof HTMLElement && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      boot();
    }, { rootMargin: '480px' });
    observer.observe(section);
  } else {
    window.addEventListener('load', boot, { once: true });
  }
</script>
