---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VideoCard from '../components/VideoCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { catalog, videoPath } from '../lib/catalog';
import Picture from '../components/Picture.astro';
import { formatCompact, formatDate } from '../lib/format';

const videos = catalog.videos;
const featured = videos[0] ?? null;
const rest = videos.slice(1);
---
<Base title="Aktuelles" description="Die neuesten Veröffentlichungen von Politik mit Kopf und Politik mit Kopf REAGIERT." lcpImage={featured?.thumbnail} lcpSizes="(max-width: 980px) 92vw, 640px">
  <div class="wrap">
    <Breadcrumbs items={[{ href: '/aktuelles/', label: 'Aktuelles' }]} />
    <PageHeader
      kicker="Laufend"
      title="Aktuelles"
      lede="Neue Videos erscheinen hier automatisch – mit Vorschaubild, Laufzeit und direktem Zugang zum Beitrag."
    />

    {catalog.live && (
      <a class="aktuelles-live" href={catalog.live.url} rel="noopener noreferrer">
        <span class="live-dot" aria-hidden="true"></span>
        <span>
          <strong>{catalog.live.channelName} ist live</strong>
          <span class="sync-note">{catalog.live.title}</span>
        </span>
        <span class="link-arrow">Livestream ansehen</span>
      </a>
    )}

    {videos.length === 0 ? (
      <EmptyState title="Aktuell sind noch keine Beiträge vorhanden." actionHref="/videos/" action="Zum Archiv" />
    ) : (
      <div class="aktuelles-feed">
        {featured && (
          <a class="aktuelles-lead" href={videoPath(featured)}>
            <div class="thumb">
              <Picture src={featured.thumbnail} width={1280} height={720} sizes="(max-width: 980px) 92vw, 640px" priority={true} fallback={featured.thumbnailRemote} />
              <span class="play" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9 7.2v9.6L17.5 12 9 7.2z"/></svg>
              </span>
              {featured.durationLabel && <span class="duration">{featured.durationLabel}</span>}
            </div>
            <div class="aktuelles-lead-copy">
              <p class="kicker">Neueste Veröffentlichung</p>
              <p class="byline">
                <span>{featured.channelName}</span>
                <time datetime={featured.publishedAt}>{formatDate(featured.publishedAt)}</time>
              </p>
              <h2>{featured.title}</h2>
              <p class="excerpt">{featured.excerpt}</p>
              {(featured.stats?.viewCount != null || featured.stats?.likeCount != null) && (
                <p class="stat-row">
                  {featured.stats.viewCount != null && <span>{formatCompact(featured.stats.viewCount)} Aufrufe</span>}
                  {featured.stats.likeCount != null && <span>{formatCompact(featured.stats.likeCount)} Likes</span>}
                </p>
              )}
              <span class="button">Video ansehen</span>
            </div>
          </a>
        )}

        {rest.length > 0 && (
          <section class="section" style="padding-top:28px">
            <div class="section-head">
              <h2>Weitere aktuelle Videos</h2>
              <a class="link-arrow" href="/videos/">Alle Videos</a>
            </div>
            <div class="aktuelles-grid">
              {rest.map((video) => (
                <VideoCard video={video} variant="standard" />
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</Base>
