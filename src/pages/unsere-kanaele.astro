---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ChannelBadges from '../components/ChannelBadges.astro';
---
<Base title="Meine Kanäle" description="Politik mit Kopf auf YouTube, TikTok, Telegram, WhatsApp und X.">
  <div class="wrap">
    <Breadcrumbs items={[{ href: '/unsere-kanaele/', label: 'Meine Kanäle' }]} />
    <PageHeader
      kicker="Kanäle"
      title="Meine Kanäle"
      lede="YouTube, TikTok, Telegram, WhatsApp und X – direkt erreichbar."
    />
    <ChannelBadges size="section" />
  </div>
</Base>
