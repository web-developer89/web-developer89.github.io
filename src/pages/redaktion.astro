---
import Base from '../layouts/Base.astro';
import { catalog, allChannelDirectory, channelDirectory, youtube } from '../lib/catalog';
import { formatDateTime, formatNumber } from '../lib/format';
import { socials } from '../config/social';
import { support } from '../config/support';
import snapshotsFile from '../data/snapshots.json';

const channels = allChannelDirectory();
const youtubeLive = channelDirectory();
const snapshots = (snapshotsFile as { channelSnapshots?: Array<{ at: string; channelId: string; subscriberCount: number | null }> }).channelSnapshots || [];
const latestByChannel = youtubeLive.map((channel) => {
  const snaps = snapshots.filter((item) => item.channelId === channel.channelId);
  const latest = snaps[snaps.length - 1] ?? null;
  return {
    ...channel,
    snapshotCount: snaps.length,
    latestSnapshotAt: latest?.at ?? null,
  };
});

const statusLabel = {
  verbunden: 'Verbunden',
  deaktiviert: 'Deaktiviert',
  fehler: 'Fehler',
} as const;
const sourceLabel = {
  rss: 'Öffentlicher RSS-Feed, letzte 15 Videos je Kanal',
  'youtube-data-api': 'YouTube Data API',
  'youtube-public': 'Öffentliche YouTube-Daten (Videos + Statistiken)',
  mixed: 'Gemischte Quellen',
  none: 'Noch keine Übernahme',
} as const;
---
<Base title="Synchronisation" description="Stand der YouTube-Übernahme und Abonnentenstatistik." noindex={true}>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">Redaktion</p>
      <h1>Synchronisation</h1>
      <p class="lede">Diese Seite zeigt den Stand. Einstellungen liegen in der Konfiguration und werden nicht von hier aus geändert.</p>
    </header>

    <section class="surface" style="padding:20px;margin:0 0 28px;display:grid;gap:12px">
      <h2 style="margin:0">Abonnentenstatistik</h2>
      <p class="legal-note" style="margin:0">Öffentliche Abonnentenzahlen aus der letzten erfolgreichen YouTube-Synchronisierung. Keine erfundenen Werte.</p>
      <table class="table">
        <thead>
          <tr><th>Kanal</th><th>Kanal-ID</th><th>Abonnenten</th><th>Snapshots</th><th>Letzter Snapshot</th></tr>
        </thead>
        <tbody>
          {latestByChannel.map((channel) => (
            <tr>
              <td>{channel.name}</td>
              <td><span class="legal-note">{channel.channelId}</span></td>
              <td>{channel.stats.subscriberCount != null ? formatNumber(channel.stats.subscriberCount) : '—'}</td>
              <td>{channel.snapshotCount}</td>
              <td>{channel.latestSnapshotAt ? formatDateTime(channel.latestSnapshotAt) : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>Letzte erfolgreiche Synchronisierung: {catalog.syncedAt ? formatDateTime(catalog.syncedAt) : 'noch keine'}</p>
      <p>API-/Quellenstatus: {sourceLabel[catalog.source]}{catalog.error ? ` · Fehler: ${catalog.error}` : ''}</p>
      <p class="legal-note">
        Ein manueller Knopf „Jetzt aktualisieren“ setzt eine authentifizierte Backend-Aktion voraus.
        Auf GitHub Pages läuft die Synchronisierung über den geplanten Workflow (mindestens alle 5 Minuten laut GitHub Actions).
        Lokal: <code>npm run sync</code>.
      </p>
      <a class="button ghost" href="https://github.com/web-developer89/web-developer89.github.io/actions" rel="noopener noreferrer">Workflows öffnen</a>
    </section>

    <p>Letzte Übernahme: {catalog.syncedAt ? formatDateTime(catalog.syncedAt) : 'noch keine'}</p>
    <p>Quelle: {sourceLabel[catalog.source]}</p>
    <p>Videos: {catalog.videos.length}</p>
    <p>Live: {catalog.live ? catalog.live.title : 'Kein Livestream erkannt'}</p>
    {catalog.error && <p role="status">{catalog.error}</p>}
    <h2>YouTube-Kanäle</h2>
    <table class="table">
      <thead>
        <tr><th>Kanal</th><th>Status</th><th>Videos</th><th>Modus</th></tr>
      </thead>
      <tbody>
        {channels.map((channel) => (
          <tr>
            <td>{channel.name}<br /><span class="legal-note">{channel.channelId}</span></td>
            <td>{statusLabel[channel.status]}</td>
            <td>{channel.videoCount}</td>
            <td>{channel.featured ? 'Hervorgehoben' : 'Kanal'}{youtube.featuredMode === 'manual' ? ', Fokus manuell' : ', Fokus automatisch'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <h2>Social Media</h2>
    <table class="table">
      <thead><tr><th>Dienst</th><th>Status</th></tr></thead>
      <tbody>
        {socials.map((item) => (
          <tr>
            <td>{item.label}</td>
            <td>{item.connected && item.href ? 'Verbunden' : 'Nicht verbunden'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <h2>Unterstützung</h2>
    <p>Überweisung: {support.banks.some((bank) => bank.enabled) ? `${support.banks.filter((bank) => bank.enabled).length} Konten hinterlegt` : 'Nicht hinterlegt'}</p>
    <p>Weitere Zahlungswege: {support.links.length ? 'Hinterlegt' : 'Nicht hinterlegt'}</p>
    <h2>Overlays für OBS</h2>
    <ul>
      <li><a href="/overlay/news/?preview=1">Schlagzeile</a></li>
      <li><a href="/overlay/headline/?preview=1">Headline</a></li>
      <li><a href="/overlay/ticker/?preview=1">Ticker</a></li>
      <li><a href="/overlay/latest-video/?preview=1">Neuestes Video</a></li>
      <li><a href="/overlay/live/?preview=1">Live</a></li>
      <li><a href="/overlay/socials/?preview=1">Socials</a></li>
      <li><a href="/overlay/custom/?preview=1">Freier Text</a></li>
    </ul>
    <p class="legal-note">Texte für Ticker und freie Einblendung stehen in src/content/overlay.json. Die OBS-Seiten aktualisieren sich nach der nächsten Veröffentlichung.</p>
  </div>
</Base>
