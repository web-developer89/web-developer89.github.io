---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden" description="Diese Adresse gibt es nicht. Zurück zur Startseite von Politik mit Kopf." noindex={true}>
  <div class="wrap">
    <header class="page-head not-found">
      <figure class="not-found-figure">
        <picture>
          <source type="image/avif" srcset="/images/404-reichstag.avif 1024w" sizes="(max-width: 760px) 92vw, 720px" />
          <source
            type="image/webp"
            srcset="/images/404-reichstag-640.webp 640w, /images/404-reichstag.webp 1024w"
            sizes="(max-width: 760px) 92vw, 720px"
          />
          <img
            src="/images/404-reichstag.webp"
            alt="Stilisierte Darstellung des Reichstags mit einer Explosion auf der Kuppel."
            width="1024"
            height="576"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </figure>
      <p class="kicker">404</p>
      <h1>Seite nicht gefunden</h1>
      <p class="lede">Diese Adresse ist in die Luft gegangen. Die Kuppel steht noch, die Seite leider nicht.</p>
      <div class="hero-actions">
        <a class="button" href="/">Zur Startseite</a>
      </div>
      <p class="not-found-next"><a class="link-arrow" href="/suche/">Zur Suche</a></p>
    </header>
  </div>
</Base>
