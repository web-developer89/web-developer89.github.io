---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import { publisherLines } from '../config/site';
---
<Base title="Kontakt" description="Kontakt zu Politik mit Kopf und zur MK Swiss Media GmbH.">
  <div class="wrap">
    <Breadcrumbs items={[{ href: '/kontakt/', label: 'Kontakt' }]} />
    <PageHeader kicker="Schreiben" title="Kontakt" lede={publisherLines.join(', ')} />
    <ContactForm />
  </div>
</Base>
