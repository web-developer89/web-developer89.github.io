---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../config/site';
import { topics } from '../../config/topics';
import { videosForTopic } from '../../lib/catalog';
---
<Base title="Themen" description={site.description}>
  <div class="wrap">
    <Breadcrumbs items={[{ href: '/themen/', label: 'Themen' }]} />
    <PageHeader kicker="Schwerpunkte" title="Themen" lede={site.description} />
    <ol class="topic-index">
      {topics.map((topic, index) => {
        const count = videosForTopic(topic.slug).length;
        return (
          <li>
            <a href={`/themen/${topic.slug}/`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {topic.title}
              <span>{count === 1 ? '1 Video' : `${count} Videos`}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</Base>
