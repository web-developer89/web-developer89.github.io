---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { channelDirectory, getTikTok, youtubeSubscribeUrl } from '../lib/catalog';
import { formatCompact, formatNumber } from '../lib/format';

const channels = channelDirectory();
const tiktokChannel = getTikTok();

const entries = [
  ...channels.map((channel) => ({
    key: channel.id,
    platform: 'YouTube',
    name: channel.name,
    handle: channel.handle || '',
    avatar: channel.avatar,
    href: `/${channel.slug}/`,
    cta: 'Kanalseite',
    external: false,
    subscribeHref: youtubeSubscribeUrl(channel),
    metric:
      channel.stats.subscriberCount != null
        ? { value: formatCompact(channel.stats.subscriberCount), label: 'Abonnenten', title: formatNumber(channel.stats.subscriberCount) }
        : null,
  })),
  ...(tiktokChannel
    ? [{
        key: 'tiktok',
        platform: 'TikTok',
        name: tiktokChannel.name,
        handle: tiktokChannel.handle,
        avatar: tiktokChannel.avatar,
        href: tiktokChannel.profileUrl,
        cta: 'Profil öffnen',
        external: true,
        subscribeHref: null as string | null,
        metric:
          tiktokChannel.stats.followerCount != null
            ? {
                value: formatCompact(tiktokChannel.stats.followerCount),
                label: 'Follower',
                title: formatNumber(tiktokChannel.stats.followerCount),
              }
            : null,
      }]
    : []),
];
---
<Base title="Unsere Kanäle" description="Politik mit Kopf auf YouTube und TikTok.">
  <div class="wrap">
    <Breadcrumbs items={[{ href: '/unsere-kanaele/', label: 'Unsere Kanäle' }]} />
    <PageHeader kicker="Kanäle" title="Unsere Kanäle" lede="Drei Ausspielwege, eine redaktionelle Linie." />

    <ul class="channel-directory">
      {entries.map((entry) => (
        <li class="channel-row">
          <img src={entry.avatar} alt="" width="48" height="48" data-fallback="/brand/mark.jpg" />
          <div class="channel-row-copy">
            <p class="channel-row-platform">{entry.platform}</p>
            <h2>{entry.name}</h2>
            <p class="channel-row-handle">{entry.handle}</p>
          </div>
          {entry.metric && (
            <p class="channel-row-metric" title={entry.metric.title}>
              <strong>{entry.metric.value}</strong>
              <span>{entry.metric.label}</span>
            </p>
          )}
          <div class="channel-row-actions">
            <a class="link-arrow" href={entry.href} rel={entry.external ? 'noopener noreferrer' : undefined}>{entry.cta}</a>
            {entry.subscribeHref && (
              <a class="link-arrow" href={entry.subscribeHref} rel="noopener noreferrer">Abonnieren</a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
