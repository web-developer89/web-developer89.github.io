# Optional. Ohne Schlüssel liest die Synchronisation den öffentlichen RSS-Feed
# (die letzten 15 Videos je Kanal). Mit Schlüssel werden Archiv, Laufzeiten,
# Live-Status und öffentliche Statistiken über die YouTube Data API geladen.
YOUTUBE_API_KEY=

# Optional. Überschreibt die Kanal-ID des als featured markierten Kanals
# in src/config/youtube.json. Weitere Kanäle werden in dieser Datei gepflegt.
YOUTUBE_CHANNEL_ID=

# Nicht im Frontend verwenden. API-Schlüssel gehören nur in Server-/CI-Secrets.
# GitHub Pages: Repository → Settings → Secrets → Actions → YOUTUBE_API_KEY

# Optional. Eigenes Kontakt-Endpoint (Formspree, Web3Forms, eigener Server).
# Ohne Wert geht das Beratungsformular an FormSubmit → kontakt@politikmitkopf.de.
# Beim ersten Versand muss FormSubmit einmal per E-Mail bestätigt werden.
PUBLIC_CONTACT_ENDPOINT=
