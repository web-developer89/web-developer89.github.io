---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { publisherLines, site } from '../config/site';

const mailHref = `mailto:${site.contactEmail}`;
---
<Base
  title="Impressum"
  description={`Impressum der ${site.publisher.legalName}, ${site.publisher.street}, ${site.publisher.postalCode} ${site.publisher.city}, ${site.publisher.country}.`}
>
  <div class="wrap prose">
    <Breadcrumbs items={[{ href: '/impressum/', label: 'Impressum' }]} />
    <PageHeader kicker="Rechtliches" title="Impressum" />
    <p>
      {publisherLines.map((line) => <span>{line}<br /></span>)}
    </p>
    <h2>Kontakt</h2>
    <p>
      E-Mail:
      <a href={mailHref}>{site.contactEmail}</a>
      <button class="button ghost small" type="button" data-copy={site.contactEmail} data-copy-success="E-Mail-Adresse kopiert" style="margin-left:10px">E-Mail kopieren</button>
    </p>
    <h2>Handelsregistereintrag</h2>
    <p>Nummer: {site.publisher.registerNumber}<br />{site.publisher.registerCourt}</p>
  </div>
</Base>
