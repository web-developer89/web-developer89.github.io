---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { channelDirectory, getTikTok, youtubeSubscribeUrl } from '../lib/catalog';
import { formatNumber } from '../lib/format';

const channels = channelDirectory();
const tiktokChannel = getTikTok();
---
<Base title="Unsere Kanäle" description="Politik mit Kopf auf YouTube und TikTok.">
  <div class="wrap">
    <Breadcrumbs items={[{ href: '/unsere-kanaele/', label: 'Unsere Kanäle' }]} />
    <PageHeader kicker="Kanäle" title="Unsere Kanäle" lede="YouTube-Hauptkanal, REAGIERT und TikTok – eine gemeinsame redaktionelle Linie." />
    <div class="channel-grid" style="margin:28px 0 48px">
      {channels.map((channel) => (
        <article class="channel-card">
          <div class="header">
            <img src={channel.avatar} alt="" width="72" height="72" />
            <div>
              <h2>{channel.name}</h2>
              <p class="sync-note" style="margin:6px 0 0">YouTube · {channel.handle}</p>
            </div>
          </div>
          <p>{channel.description}</p>
          {channel.stats.subscriberCount != null && (
            <p><strong>{formatNumber(channel.stats.subscriberCount)}</strong> Abonnenten</p>
          )}
          <div class="hero-actions">
            <a class="button" href={`/${channel.slug}/`}>Kanalseite</a>
            <a class="button ghost" href={youtubeSubscribeUrl(channel)} rel="noopener noreferrer">Jetzt abonnieren</a>
          </div>
        </article>
      ))}
      {tiktokChannel && (
        <article class="channel-card">
          <div class="header">
            <img src={tiktokChannel.avatar} alt="" width="72" height="72" data-fallback="/brand/mark.jpg" />
            <div>
              <h2>TikTok · {tiktokChannel.name}</h2>
              <p class="sync-note" style="margin:6px 0 0">{tiktokChannel.handle}</p>
            </div>
          </div>
          <p>{tiktokChannel.description}</p>
          <p class="channel-metrics">
            {tiktokChannel.stats.followerCount != null && (
              <span><strong>{formatNumber(tiktokChannel.stats.followerCount)}</strong> Follower</span>
            )}
            {tiktokChannel.stats.likeCount != null && (
              <span><strong>{formatNumber(tiktokChannel.stats.likeCount)}</strong> Likes</span>
            )}
            {tiktokChannel.stats.videoCount != null && (
              <span><strong>{formatNumber(tiktokChannel.stats.videoCount)}</strong> Videos</span>
            )}
          </p>
          <div class="hero-actions">
            <a class="button" href={tiktokChannel.profileUrl} rel="noopener noreferrer">TikTok öffnen</a>
          </div>
        </article>
      )}
    </div>
  </div>
</Base>
<style>
  .channel-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin: 0 0 8px;
  }
  .channel-metrics span { color: var(--muted); }
  .channel-metrics strong { color: var(--ink); }
</style>
