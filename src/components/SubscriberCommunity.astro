---
import { channelDirectory, catalog, youtubeSubscribeUrl } from '../lib/catalog';
import { formatDateTime, formatNumber } from '../lib/format';
import snapshotsFile from '../data/snapshots.json';

const channels = channelDirectory().filter((channel) => channel.id === 'primary' || channel.id === 'reagiert');
const youtubeChannels = channels.map((channel) => ({
  id: channel.id,
  channelId: channel.channelId,
  name: channel.name,
  slug: channel.slug,
  avatar: channel.avatar,
  subscribeUrl: youtubeSubscribeUrl(channel),
  stats: {
    subscriberCount: channel.stats?.subscriberCount ?? null,
    hiddenSubscriberCount: channel.stats?.hiddenSubscriberCount ?? false,
  },
}));

const combined = youtubeChannels.reduce((sum, channel) => {
  const value = channel.stats.subscriberCount;
  return value == null ? sum : (sum ?? 0) + value;
}, null as number | null);

const payload = {
  syncedAt: catalog.syncedAt,
  syncOk: Boolean(catalog.syncedAt) && !catalog.error,
  syncError: catalog.error || null,
  channels: youtubeChannels,
  combined,
  snapshots: {
    channelSnapshots: (snapshotsFile as { channelSnapshots?: unknown[] }).channelSnapshots || [],
  },
};
const json = JSON.stringify(payload).replace(/</g, '\\u003c');
---
<section class="section community-section" id="community" data-subscriber-refresh>
  <div class="wrap">
    <header class="section-intro">
      {combined != null && (
        <p class="community-combined">
          <span class="label">Meine YouTube-Community</span>
          <strong data-combined-count>{formatNumber(combined)}</strong>
          <span class="hint">Summe der öffentlich ausgewiesenen Abonnements beider Kanäle — nicht gleichbedeutend mit einzigartigen Personen.</span>
        </p>
      )}
    </header>

    <div class="subscriber-panels" data-subscriber-panels>
      {youtubeChannels.map((channel) => (
        <article class:list={['subscriber-panel', `is-${channel.id}`]} data-channel-panel={channel.channelId}>
          <div class="subscriber-panel-top">
            <img src={channel.avatar} alt="" width="72" height="72" loading="lazy" decoding="async" />
            <div>
              <h3>{channel.name}</h3>
              <p class="sr-only">YouTube-Kanal-ID: {channel.channelId}</p>
            </div>
          </div>
          <p class="subscriber-count">
            <span class="sr-only">Aktuelle Abonnenten:</span>
            <strong data-sub-count>{channel.stats.subscriberCount != null ? formatNumber(channel.stats.subscriberCount) : '—'}</strong>
            <span class="unit">Abonnenten</span>
          </p>
          <p class="subscriber-delta" data-sub-delta>—</p>
          <div class="subscriber-spark" data-sub-spark aria-hidden="true"></div>
          <p class="growth-note" data-sub-stamp>
            {catalog.syncedAt
              ? <>Zuletzt aktualisiert: <time datetime={catalog.syncedAt}>{formatDateTime(catalog.syncedAt)}</time></>
              : 'Noch keine erfolgreiche Synchronisierung'}
          </p>
          <div class="hero-actions">
            <a class="button" href={channel.subscribeUrl} rel="noopener noreferrer">Jetzt abonnieren</a>
            <a class="button ghost" href={`/${channel.slug}/`}>Zum Kanal</a>
          </div>
        </article>
      ))}
    </div>

    <div class="development-board" data-development-board>
      <div class="section-head">
        <div>
          <h3>Meine Kanalentwicklung</h3>
          <p class="lede" style="margin:4px 0 0;font-size:0.88rem">Öffentliche Abonnentenzahlen aus echten YouTube-Messpunkten.</p>
        </div>
        <div class="chip-row" role="group" aria-label="Zeitraum" data-period-filters>
          <button class="chip" type="button" data-period="24h">24 Stunden</button>
          <button class="chip is-active" type="button" data-period="7d">7 Tage</button>
          <button class="chip" type="button" data-period="30d">30 Tage</button>
        </div>
      </div>
      <div class="development-chart" data-dev-chart role="img" aria-label="Abonnentenentwicklung beider YouTube-Kanäle"></div>
      <p class="growth-note" data-dev-caption></p>
      <ul class="development-legend" data-dev-legend aria-hidden="true"></ul>
    </div>
  </div>
  <script type="application/json" id="subscriber-payload" set:html={json} />
</section>
<script>
  import { setupSubscriberBoard } from '../scripts/subscriber-board.ts';
  setupSubscriberBoard();
</script>
